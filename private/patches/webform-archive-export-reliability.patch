+  /**
+   * {@inheritdoc}
+   */
+  public function closeArchive() {
+    if (isset($this->archive)) {
+      // A ZipArchive only commits its buffered entries to disk when closed;
+      // unlike Archive_Tar (which writes/rewrites the file on every single
+      // add), relying on the object simply going out of scope to flush it
+      // is not reliable across the separate exporter plugin instances used
+      // by each Batch API operation, and can silently drop an entire
+      // operation's worth of files. Archive_Tar has no such requirement:
+      // every add already opens, appends, and closes the file in full.
+      if ($this->archive instanceof \ZipArchive) {
+        $this->archive->close();
+      }
+      $this->archive = NULL;
+    }
+  }
