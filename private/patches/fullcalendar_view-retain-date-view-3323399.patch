+  // Store current info.
+  function storeCurrentMonthAndView() {
+    $('.js-drupal-fullcalendar')
+    .each(function () {
+      let calendarEl = this;
+      let viewIndex = parseInt(calendarEl.getAttribute("data-calendar-view-index"));
