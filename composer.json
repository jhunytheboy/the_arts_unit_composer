        "drupal/twig_tweak": "^3.4",
        "drupal/typed_data": "^2.1",
        "drupal/unpublished_404": "^2.0",
        "drupal/vapn": "^3.0@alpha",
        "drupal/verf": "^2.0",
        "drupal/view_mode_page": "^4.0",
        "drupal/view_unpublished": "^1.0",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.1",
        "drupal/views_conditional": "^1.10",
        "drupal/views_data_export": "^1.0",
        "drupal/views_expandable_table": "^1.0@RC",
        "drupal/views_filters_summary": "^3.0@beta",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.2",
        "drupal/webform_entity_view": "^1.0",
        "drupal/webform_spam_words": "^2.0",
        "drupal/webform_xlsx_export": "^1.0",
        "drupal/weight": "^3.3",
        "drupal/yaml_editor": "^1.1",
        "drush/drush": "^12",
        "geocoder-php/google-maps-provider": "^4.7",
        "kint-php/kint": "^5.1",
        "vakata/jstree": "^3.3",
        "vimeo/vimeo-api": "^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/.htaccess": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "installer-types" : ["bower-asset", "npm-asset"],
        "patches" : {
            "drupal/ckeditor_accordion": {
                "HTML in tab head (https://www.drupal.org/project/ckeditor_accordion/issues/3355048)": "https://git.drupalcode.org/project/ckeditor_accordion/-/merge_requests/7.diff"
            },
            "drupal/backup_migrate" : {
                "Add Drush command for running a quick backup (https://www.drupal.org/project/backup_migrate/issues/3223057)": "https://www.drupal.org/files/issues/2021-12-02/3223057-17.patch"
            },
            "drupal/linkchecker" : {
                "Remove redirect checker" : "private/patches/linkchecker-remove-redirect-message.patch"
            },
            "drupal/fullcalendar_view" : {
                "Disable ajaxcomplete (based on https://www.drupal.org/project/fullcalendar_view/issues/3323399 )": "private/patches/fullcalendar_view-disable-ajaxcomplete.patch"
            },
            "drupal/view_mode_page" : {
                "Context exception when trying to create url (Drupal 10 is broken!) ( https://www.drupal.org/project/view_mode_page/issues/3300706 )" : "https://www.drupal.org/files/issues/2023-05-01/3300706-17-context_exception_when_trying_to_create_url_0.patch"
            },
            "drupal/page_manager" : {
                "Some mandatory parameters are missing ( https://www.drupal.org/project/page_manager/issues/3438993 )" : "https://www.drupal.org/files/issues/2024-08-14/page-manager-3438993-MR34-24.patch"
            },
            "drupal/smart_date" : {
                "Refactor suppression of extra input row (Add 'remove' button) ( https://www.drupal.org/project/smart_date/issues/3452463 )" : "https://git.drupalcode.org/project/smart_date/-/merge_requests/124.diff"
            },
            "drupal/core" : {
                "Diffs with different line endings leads to Invalid $mode 3 specified ( https://www.drupal.org/project/drupal/issues/3389715 )" : "https://www.drupal.org/files/issues/2024-01-09/Diffs-with-different-line-endings-leads-to-Invalid-mode-3-specified.patch",
                "Notice: Undefined index: value in Drupal\\views\\Plugin\\views\\filter\\NumericFilter->acceptExposedInput() ( https://www.drupal.org/project/drupal/issues/2825860 )" : "https://www.drupal.org/files/issues/2024-06-13/2825860-175.patch"
            },
            "drupal/name": {
                "The database connection is not serializable ( https://www.drupal.org/project/name/issues/3468684 )" : "https://git.drupalcode.org/project/name/-/merge_requests/19.diff"
            },
            "drupal/media_directories": {
                "Allow seven subtheme to load claro library (based on https://www.drupal.org/project/media_directories/issues/3395412 )" : "private/patches/media_directories_seven_subtheme.patch"
            },
            "drupal/views_filters_summary": {
                "Display VERF labels (based on https://www.drupal.org/project/views_filters_summary/issues/3380427 )": "private/patches/verf.patch"
            }
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/webform/composer.libraries.json",
                "web/modules/contrib/media_directories/composer.libraries.json",
                "web/modules/contrib/anchor_link/composer.libraries.json"
            ]
        }
    }
}
