        "drupal/content_moderation_notifications": "^3.3",
        "drupal/core-composer-scaffold": "^10",
        "drupal/core-project-message": "^10",
        "drupal/core-recommended": "^10",
        "drupal/csv_importer": "^1.11",
        "drupal/csv_serialization": "4.0.0",
        "drupal/ctools": "^4.1",
