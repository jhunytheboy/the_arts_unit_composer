   /**
+   * Load the child links of a book page the current user can view.
+   *
+   * @param int $pid
+   *   The parent book page node ID.
+   *
+   * @return array
+   *   Items shaped like bookSubtreeData() children ('link' key), sorted by
+   *   weight then title.
+   */
+  protected function loadSiblings(int $pid) {
+    $items = [];
+    if (!$pid) {
+      return $items;
+    }
+    foreach (\Drupal::service('book.outline_storage')->loadBookChildren($pid) as $link) {
+      $this->bookManager->bookLinkTranslate($link);
+      if (!empty($link['access'])) {
+        $items[] = ['link' => $link];
+      }
+    }
+    usort($items, function ($a, $b) {
+      return [(int) $a['link']['weight'], $a['link']['title']] <=> [(int) $b['link']['weight'], $b['link']['title']];
+    });
+    return $items;
+  }
