        "drupal/mail_login": "^2.4",
        "drupal/mailchimp": "^2.0",
        "drupal/mailsystem": "^4.4",
        "drupal/media_directories": "^2.1@beta",
        "drupal/media_entity_file_replace": "^1.0",
        "drupal/menu_item_role_access": "^2.0",
        "drupal/menu_link_attributes": "^1.2",
        "drupal/metatag": "^1.16",
        "drupal/name": "^1.0@RC",
        "drupal/nbsp": "^2.3",
        "drupal/node_revision_delete": "^2.0@RC",
        "drupal/orphaned_files": "^1.0",
        "drupal/page_manager": "^4.0@RC",
        "drupal/panels": "^4.8",
        "drupal/paragraph_view_mode": "^3.1",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/protected_pages": "^1.4",
        "drupal/publication_date": "^2.0@beta",
        "drupal/quick_node_block": "^1.3",
        "drupal/quick_node_clone": "^1.14",
        "drupal/rabbit_hole": "^1.0@beta",
        "drupal/recaptcha": "^3.0",
        "drupal/recaptcha_v3": "^1.4",
        "drupal/redirect": "^1.6",
        "drupal/redirect_metrics": "^2.0",
        "drupal/scheduler": "^2.1",
        "drupal/search_api": "^1.37",
        "drupal/search_api_exclude_entity": "^2.0",
        "drupal/search_api_page": "^1.1",
        "drupal/search_api_sorts": "^1.2",
        "drupal/select2": "^1.15",
        "drupal/selective_better_exposed_filters": "^3.0",
        "drupal/seven": "^1.0",
