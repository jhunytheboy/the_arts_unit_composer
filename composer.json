    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "public_html/"
            },
            "file-mapping": {
                "[web-root]/.htaccess": false
            }
        },
        "installer-paths": {
            "public_html/core": [
                "type:drupal-core"
            ],
            "public_html/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "public_html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "public_html/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "public_html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "public_html/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "public_html/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "public_html/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "installer-types" : ["bower-asset", "npm-asset"],
        "patches" : {
            "drupal/backup_migrate" : {
                "Add Drush command for running a quick backup (https://www.drupal.org/project/backup_migrate/issues/3223057)": "https://www.drupal.org/files/issues/2021-12-02/3223057-17.patch"
            },
            "drupal/csv_importer" : {
                "ImporterBase::attach() downloads any http(s) URL value as a file, corrupting non-file fields like link fields": "private/patches/csv_importer-attach-only-file-fields.patch"
            },
            "drupal/entity_reference_revisions" : {
                "EntityReferenceRevisionsFieldItemList::hasAffectingChanges() returns on the first delta, so edits to paragraphs beyond the first are never detected as changes (https://www.drupal.org/project/entity_reference_revisions/issues/3582279)": "private/patches/entity_reference_revisions-hasAffectingChanges-3582279.patch"
            },
            "drupal/webform" : {
                "Archive exports (attachments/uploaded files) are unreliable for file-heavy webforms: lowers the batch size so a single request doesn't have to build the whole archive at once, and explicitly closes/flushes each batch's ZIP archive so later batches don't silently lose the files added by earlier ones": "private/patches/webform-archive-export-reliability.patch"
            },
            "drupal/linkchecker" : {
                "Remove redirect checker" : "private/patches/linkchecker-remove-redirect-message.patch"
            },
            "drupal/fullcalendar_view" : {
                "Disable ajaxcomplete (based on https://www.drupal.org/project/fullcalendar_view/issues/3323399 )": "https://www.drupal.org/files/issues/2024-11-18/fullcalendar_retain_data_view-3323399-11.patch"
            },
            "drupal/page_manager" : {
                "Some mandatory parameters are missing ( https://www.drupal.org/project/page_manager/issues/3438993 )" : "https://www.drupal.org/files/issues/2024-08-14/page-manager-3438993-MR34-24.patch"
            },
            "drupal/core" : {
                "Diffs with different line endings leads to Invalid $mode 3 specified ( https://www.drupal.org/project/drupal/issues/3389715 )" : "https://www.drupal.org/files/issues/2024-01-09/Diffs-with-different-line-endings-leads-to-Invalid-mode-3-specified.patch",
                "Notice: Undefined index: value in Drupal\\views\\Plugin\\views\\filter\\NumericFilter->acceptExposedInput() ( https://www.drupal.org/project/drupal/issues/2825860 )" : "https://www.drupal.org/files/issues/2024-06-13/2825860-175.patch"
            },
            "drupal/book": {
                "Keep book navigation visible on child pages when the book's top page is unpublished ( related: https://www.drupal.org/project/drupal/issues/3020298 )" : "private/patches/book-navigation-visible-unpublished-root.patch"
            },
            "drupal/media_directories": {
                "Allow seven subtheme to load claro library (based on https://www.drupal.org/project/media_directories/issues/3395412 )" : "private/patches/media_directories_seven_subtheme.patch"
            },
            "drupal/verf": {
                "Performance problem ( https://www.drupal.org/project/verf/issues/2998697 )": "https://www.drupal.org/files/issues/2023-05-12/verf-load_options-2998697-26.patch"
            },
            "drupal/unpublished_404": {
                "if node is a string look up the node id for published status": "private/patches/unpublished_404-merge-request-1.diff"
            },
            "drupal/better_exposed_filters": {
                "Undefined array key #default_value in BetterExposedFilters.php ( https://www.drupal.org/project/better_exposed_filters/issues/3349448 )": "https://git.drupalcode.org/project/better_exposed_filters/-/merge_requests/200.diff"
            },
            "drupal/login_destination": {
                "isRouted() on string fix #3529641": "https://www.drupal.org/files/issues/2025-06-30/call_to_isrouted_on_string-3529641-5.patch"
            }
        },
        "merge-plugin": {
            "include": [
                "public_html/modules/contrib/webform/composer.libraries.json",
                "public_html/modules/contrib/media_directories/composer.libraries.json",
                "public_html/modules/contrib/anchor_link/composer.libraries.json"
            ]

        }
    }
}
