        "drupal/dynamic_entity_reference": "^4.0@alpha",
        "drupal/entity_browser": "^2.6",
        "drupal/entity_embed": "^1.1",
        "drupal/entity_export_csv": "^2.0@beta",
        "drupal/entity_hierarchy": "^3.0",
        "drupal/entity_print": "^2.6",
        "drupal/entity_reference_display": "^2.0",
        "drupal/entity_reference_unpublished": "^2.0",
        "drupal/entity_resave": "^1.0",
        "drupal/environment_indicator": "^4.0",
        "drupal/examples": "^4.0",
        "drupal/exif_orientation": "^1.4",
        "drupal/field_group": "^3.1",
        "drupal/field_permissions": "^1.2",
